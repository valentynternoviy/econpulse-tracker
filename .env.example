# Application
APP_NAME=EconPulse
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
BASE_CURRENCY=USD

# Database (PostgreSQL in Docker / production; SQLite fallback for quick local dev)
DATABASE_URL=postgresql+asyncpg://econ:econ_password@localhost:5432/econ_tracker
POSTGRES_USER=econ
POSTGRES_PASSWORD=econ_password
POSTGRES_DB=econ_tracker

# Collector & Scheduling
COLLECT_ENABLED=true
COLLECT_CONCURRENCY=4
COLLECT_TIMEOUT_SECONDS=15.0
COLLECT_MAX_RETRIES=3
PLATINUM_USD_RATE=0.04999
ANOMALY_THRESHOLD_PCT=20.0

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
